{
  "name": "@nutmeg/cli",
  "version": "1.0.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Build, test, and publish vanilla Web Components with a little spice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/nutmeg.git"
  },
  "author": {
    "name": "Abraham Williams",
    "email": "abraham@abrah.am",
    "url": "https://abrah.am"
  },
  "homepage": "https://github.com/abraham/nutmeg",
  "bugs": {
    "url": "https://github.com/abraham/nutmeg/issues"
  },
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "nutmeg-build": "bin/nutmeg-build",
    "nutmeg-clean": "bin/nutmeg-clean",
    "nutmeg-new": "bin/nutmeg-new",
    "nutmeg-serve": "bin/nutmeg-serve",
    "nutmeg-test": "bin/nutmeg-test",
    "nutmeg-watch": "bin/nutmeg-watch",
    "nutmeg": "bin/nutmeg"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "pretest": "npm run build",
    "test": "tsx ./scripts/test.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "web-components",
    "webcomponents",
    "shadow-dom",
    "shadowdom",
    "lit-html",
    "nutmeg",
    "typescript"
  ],
  "dependencies": {
    "@nutmeg/seed": "1.0.0-alpha.0",
    "@vitest/browser-playwright": "^5.0.2",
    "change-case": "^5.4.4",
    "commander": "^15.0.0",
    "lodash.template": "^4.0.0",
    "playwright": "^1.63.0",
    "recursive-copy": "^2.0.0",
    "shelljs": "^0.10.0",
    "through2": "^5.0.11",
    "ts-loader": "^9.0.0",
    "typescript": "7.0.2",
    "update-notifier": "^7.3.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "devDependencies": {
    "@types/lodash.template": "^4.0.0",
    "@types/node": "^26.6.3",
    "@types/shelljs": "^0.10.0",
    "@types/through2": "^5.0.0",
    "@types/update-notifier": "^6.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15"
  },
  "types": "dist/cli.d.ts",
  "browser": {
    "fs": false,
    "child_process": false
  },
  "directories": {
    "test": "test"
  }
}
