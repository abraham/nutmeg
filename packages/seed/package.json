{
  "name": "@nutmeg/seed",
  "version": "0.17.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Nutmeg Web Component Seed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/nutmeg.git"
  },
  "author": {
    "name": "Abraham Williams",
    "email": "abraham@abrah.am",
    "url": "https://abrah.am"
  },
  "homepage": "https://nutmeg.tools",
  "bugs": {
    "url": "https://github.com/abraham/nutmeg/issues"
  },
  "main": "dist/seed.js",
  "module": "dist/seed.js",
  "engines": {
    "node": "18 || 20 || 22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.production.json",
    "clean": "rm -rf dist/*",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "test": "npm run test:unit && npm run test:dom",
    "test:dom": "vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run",
    "watch": "tsc --watch"
  },
  "keywords": [
    "web-components",
    "webcomponents",
    "shadow-dom",
    "shadowdom",
    "lit",
    "nutmeg",
    "typescript"
  ],
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@vitest/browser": "^3.2.7",
    "playwright": "^1.63.0",
    "typescript": "5.2.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "types": "dist/seed.d.ts",
  "directories": {
    "test": "test"
  }
}
