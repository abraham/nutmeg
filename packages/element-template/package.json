{
  "name": "@nutmeg/element-template",
  "version": "1.0.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Real, buildable/testable example component: both a CI-verified demo and the copy source for `create-nutmeg`",
  "main": "dist/example-component.js",
  "module": "dist/example-component.js",
  "types": "dist/example-component.d.ts",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "keywords": [
    "example-component",
    "nutmeg"
  ],
  "license": "MIT",
  "scripts": {
    "build": "nutmeg build .",
    "prebuild": "nutmeg clean .",
    "pretest": "npm run build",
    "start": "nutmeg serve .",
    "test": "nutmeg test .",
    "watch": "nutmeg watch ."
  },
  "dependencies": {
    "@nutmeg/seed": "1.0.0-alpha.0"
  },
  "devDependencies": {
    "@nutmeg/cli": "1.0.0-alpha.0",
    "vite": "^8.0.0"
  }
}
