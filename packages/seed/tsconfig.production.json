{
  "compilerOptions": {
    "declaration": true,
    "inlineSources": true,
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "sourceRoot": "src",
    "strict": true,
    "target": "esnext",
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
