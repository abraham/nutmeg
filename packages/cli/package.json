{
  "name": "@nutmeg/cli",
  "version": "0.17.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Build, test, and publish vanilla Web Components with a little spice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/nutmeg.git"
  },
  "author": {
    "name": "Abraham Williams",
    "email": "abraham@abrah.am",
    "url": "https://abrah.am"
  },
  "homepage": "https://github.com/abraham/nutmeg",
  "bugs": {
    "url": "https://github.com/abraham/nutmeg/issues"
  },
  "main": "dist/cli.js",
  "bin": {
    "nutmeg-build": "bin/nutmeg-build",
    "nutmeg-clean": "bin/nutmeg-clean",
    "nutmeg-new": "bin/nutmeg-new",
    "nutmeg-serve": "bin/nutmeg-serve",
    "nutmeg-test": "bin/nutmeg-test",
    "nutmeg-watch": "bin/nutmeg-watch",
    "nutmeg": "bin/nutmeg"
  },
  "engines": {
    "node": "18 || 20 || 22"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "test": "npm run build",
    "watch": "tsc --watch",
    "xtest": "ts-node ./scripts/test.ts"
  },
  "keywords": [
    "web-components",
    "webcomponents",
    "shadow-dom",
    "shadowdom",
    "lit-html",
    "nutmeg",
    "typescript"
  ],
  "dependencies": {
    "@nutmeg/seed": "0.17.2",
    "@vitest/browser": "^3.2.7",
    "commander": "^11.0.0",
    "lodash.template": "^4.0.0",
    "pascal-case": "^3.0.0",
    "playwright": "^1.63.0",
    "recursive-copy": "^2.0.0",
    "shelljs": "^0.8.0",
    "through2": "^4.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "5.2.2",
    "update-notifier": "^7.3.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "devDependencies": {
    "@types/lodash.template": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/shelljs": "^0.8.0",
    "@types/through2": "^2.0.0",
    "@types/update-notifier": "^5.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.0.0"
  },
  "types": "dist/cli.d.ts",
  "browser": {
    "fs": false,
    "child_process": false
  },
  "directories": {
    "test": "test"
  }
}
