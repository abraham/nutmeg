{
  "compilerOptions": {
    "declaration": true,
    "inlineSources": false,
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "target": "esnext"
  },
  "include": ["src"],
  "exclude": ["node_modules", "element-template", "dist"]
}
