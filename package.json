{
  "name": "nutmeg",
  "version": "0.17.2",
  "private": true,
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "lerna run build",
    "format": "prettier --write .",
    "lint": "prettier --check . && syncpack lint",
    "prerelease": "lerna version --exact --no-push",
    "syncpack:fix": "syncpack fix",
    "test": "lerna run test"
  },
  "devDependencies": {
    "lerna": "^9.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-package": "2.0.0",
    "syncpack": "^15.3.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
