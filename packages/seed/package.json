{
  "name": "@nutmeg/seed",
  "version": "1.0.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Nutmeg Web Component Seed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/nutmeg.git"
  },
  "author": {
    "name": "Abraham Williams",
    "email": "abraham@abrah.am",
    "url": "https://abrah.am"
  },
  "homepage": "https://nutmeg.tools",
  "bugs": {
    "url": "https://github.com/abraham/nutmeg/issues"
  },
  "main": "dist/seed.js",
  "module": "dist/seed.js",
  "type": "module",
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "tsc --project tsconfig.production.json",
    "clean": "rm -rf dist/*",
    "prebuild": "npm run clean",
    "test": "npm run test:unit && npm run test:dom",
    "test:dom": "vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run",
    "watch": "tsc --watch"
  },
  "keywords": [
    "web-components",
    "webcomponents",
    "shadow-dom",
    "shadowdom",
    "lit",
    "nutmeg",
    "typescript"
  ],
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "types": "dist/seed.d.ts",
  "directories": {
    "test": "test"
  }
}
