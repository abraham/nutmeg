{
  "name": "nutmeg",
  "version": "0.17.2",
  "private": true,
  "engines": {
    "node": "18 || 20 || 22"
  },
  "scripts": {
    "build": "lerna run build",
    "format": "prettier --write .",
    "lint": "prettier --check . && syncpack lint",
    "prerelease": "lerna version --exact",
    "release": "lerna publish from-git",
    "syncpack:fix": "syncpack fix",
    "test": "lerna run test"
  },
  "devDependencies": {
    "lerna": "^6.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-package": "2.0.0",
    "syncpack": "^15.3.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
